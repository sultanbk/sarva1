# Use your Supabase Postgres connection string.
# Example: postgresql://postgres.<project-ref>:<database-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<supabase-host>:6543/postgres
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
API_KEY=replace-with-a-long-random-api-key
PLAN_PRICE_STARTER=0
PLAN_PRICE_GROWTH=0
PLAN_PRICE_PRO=0
PLAN_PRICE_CUSTOM=0
PORT=3000
NODE_ENV=development
ADMIN_ORIGIN=https://sarvaone-admin.vercel.app
