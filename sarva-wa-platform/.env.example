# ============================================================
# Sarva One WhatsApp Platform — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Meta WhatsApp Cloud API
# Get these from: developers.facebook.com → Your App → WhatsApp → API Setup
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=sarva_wa_verify_token_2024   # any random string you choose

# Database
DB_PATH=./data/sarva-wa.db                    # SQLite file path

# Razorpay (optional — each tenant can also have their own)
# These are Sarva One's fallback Razorpay keys
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Security
INTERNAL_API_SECRET=super_secret_key_for_pos_to_call_this_server
ENCRYPTION_KEY=32_char_random_key_for_encrypting_tokens
SYNC_API_KEY=kpt-pos-sync-secret-key-2026

# ============================================================
# DEFAULT TENANT AUTO-SEEDING (Useful for single-tenant / testing)
# If set, the server automatically onboards this tenant on startup.
# ============================================================
DEFAULT_TENANT_ID=krishnapriya-textiles
DEFAULT_TENANT_NAME="Krishnapriya Textiles"
DEFAULT_TENANT_WA_PHONE=+919108455006
DEFAULT_TENANT_WA_PHONE_ID=your_default_tenant_wa_phone_id
DEFAULT_TENANT_WA_BUSINESS_ID=your_default_tenant_wa_business_id
DEFAULT_TENANT_WA_ACCESS_TOKEN=your_default_tenant_wa_access_token

